{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentrepengine.io/schemas/reason_object_v1.json",
  "title": "AgentRepEngine Reason Object v1",
  "description": "Structured enforcement decision explanation. Every BLOCKED or AUDIT decision produces exactly one reason object.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "decision",
    "agent_did",
    "score",
    "score_delta",
    "score_period_hours",
    "trigger_events",
    "policy_fired",
    "policy_threshold",
    "recommended_action",
    "peer_cluster",
    "peer_cluster_avg_score",
    "deviation_from_cluster"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["BLOCKED", "AUDIT", "THROTTLE", "ALLOW"],
      "description": "Final enforcement decision."
    },
    "agent_did": {
      "type": "string",
      "pattern": "^did:jwt:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Cryptographic agent identity. Format: did:jwt:{org_id}:{service}:{uuid}"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Current reputation score. 0-199=BLOCKED, 200-499=RESTRICTED, 500-699=MONITORED, 700-1000=TRUSTED."
    },
    "score_delta": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000,
      "description": "Score change that triggered this decision. Negative = score decreased."
    },
    "score_period_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Hours of behavioral history used to compute this score."
    },
    "trigger_events": {
      "type": "array",
      "minItems": 1,
      "description": "Behavioral events that triggered this enforcement decision.",
      "items": {
        "type": "object",
        "required": ["event_type", "count", "window_minutes", "baseline_per_hour", "deviation_sigma"],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "bulk_pii_access",
              "permission_escalation_request",
              "cross_tenant_access_attempt",
              "recursive_agent_spawn",
              "high_frequency_tool_call",
              "credential_access_attempt",
              "mass_deletion_attempt",
              "lateral_movement_attempt",
              "prompt_injection_detected",
              "token_refresh_anomaly"
            ]
          },
          "count": { "type": "integer", "minimum": 0 },
          "window_minutes": { "type": "integer", "minimum": 1 },
          "baseline_per_hour": { "type": "number", "minimum": 0 },
          "deviation_sigma": { "type": "number" }
        }
      }
    },
    "policy_fired": {
      "type": "string",
      "description": "Name and version of the YAML policy pack that triggered this decision."
    },
    "policy_threshold": {
      "type": "string",
      "description": "Human-readable threshold description from the policy pack."
    },
    "recommended_action": {
      "type": "string",
      "description": "Recommended human action for the security team."
    },
    "peer_cluster": {
      "type": "string",
      "description": "Behavioral archetype cluster this agent belongs to."
    },
    "peer_cluster_avg_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Average reputation score of agents in the same behavioral cluster."
    },
    "deviation_from_cluster": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000,
      "description": "This agent score minus peer cluster average. Negative = below cluster average."
    }
  },
  "examples": [
    {
      "decision": "BLOCKED",
      "agent_did": "did:jwt:finserv-demo:trading-agent:001",
      "score": 187,
      "score_delta": -556,
      "score_period_hours": 6,
      "trigger_events": [
        {
          "event_type": "bulk_pii_access",
          "count": 847,
          "window_minutes": 90,
          "baseline_per_hour": 12,
          "deviation_sigma": 4.2
        }
      ],
      "policy_fired": "bulk_pii_access_prevention_v1",
      "policy_threshold": "PII access >500 records in 2h window",
      "recommended_action": "Human review before re-authorization",
      "peer_cluster": "data-analyst-agents",
      "peer_cluster_avg_score": 700,
      "deviation_from_cluster": -513
    }
  ]
}
